# ==============================================================================
# ChessBuff .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Secrets & Sensitive Credentials (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
*.pem
*.key
*.cert
*.crt

# ------------------------------------------------------------------------------
# 2. Database & Persistent Cache Files
# ------------------------------------------------------------------------------
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
chessbuff.db

# ------------------------------------------------------------------------------
# 3. Stockfish Engine Binaries & Archives (> 100MB exceeds GitHub push ceiling)
#    (Users install via: python scripts/setup_stockfish.py)
# ------------------------------------------------------------------------------
bin/
*.exe
*.dll
*.so
*.dylib
*.zip
*.tar
*.tar.gz

# ------------------------------------------------------------------------------
# 4. Python Bytecode, Caches & Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# 5. Frontend & Node.js Dependencies & Artifacts
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
.vite/
frontend/.vite/
.pnpm-store/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# ------------------------------------------------------------------------------
# 6. IDE & Code Editor Metadata
# ------------------------------------------------------------------------------
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# ------------------------------------------------------------------------------
# 7. Operating System Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
